# Copy to a private location outside the repository and set real values there.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Managed PostgreSQL in Russia (152-FZ); sslmode=verify-full with the provider's CA certificate
DATABASE_URL=postgres://anna:password@db-host:5432/anna?sslmode=require
# Connections per app process
DATABASE_POOL_SIZE=10
AUTH_CODE_SECRET=replace-with-at-least-32-random-characters
UNISENDER_GO_API_KEY=
MAIL_FROM=
# 0 disables registration and password reset emails
MAIL_DAILY_LIMIT=100
# Trust X-Real-IP from Nginx on 127.0.0.1; without it all visitors share one API limit
TRUST_PROXY=1
API_PER_IP_PER_MINUTE=60
API_GLOBAL_PER_MINUTE=600
SOTIS_VERIFY=1
# Model server: this machine by default; the GPU server's private (WireGuard) address in production
OLLAMA_URL=http://127.0.0.1:11434
FORECAST_LOCAL_MODEL=
# Optional chat model; otherwise FORECAST_LOCAL_MODEL is used.
CHAT_LOCAL_MODEL=
# Enable only for a candidate trained and checked for the internal learning signal.
# Keep 0 with anna-v10; roll back this flag together with the model name.
CHAT_LEARNING_SIGNALS=0
# Model calls running at once; extra chat questions get an immediate "busy" reply
CHAT_MAX_CONCURRENT=2
# Folder with Anna's approved materials (*.md) and approved cards (*.jsonl) for chat retrieval; outside the repository
KNOWLEDGE_PATH=
# Public address of the site (payment return links, link previews); https is required in production
# v19 protocol is independent of learned learning offers. Leave CHAT_LEARNING_SIGNALS off
# to retain the established rule-based invitation policy. Both are opt-in.
CHAT_MODEL_PROTOCOL=
# 1 = retry explicit known factual mistakes once; any correction fallback is marked as such.
CHAT_FACT_GUARD=0
# v19 also needs ANNA_TRAINING_PROMPT_VERSION=18, ANNA_REFERENCE_KNOWLEDGE=19,
# and a private ANNA_METHODICS_FILE with ANNA_METHODICS_SHA256 matching its snapshot.
PUBLIC_URL=https://example.org
# 1 = sign-up requires consent to personal data processing (required in production; the UI sends privacyConsent: true)
REQUIRE_PRIVACY_CONSENT=1
# Ownership codes from Yandex Webmaster and Google Search Console ("meta tag" method): only the content value
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
# Payments: empty = off; yookassa in production; test only for local development
BILLING_PROVIDER=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Cards of foreign banks (Visa/Mastercard from abroad), prices in USD/EUR: empty = off
BILLING_INTL_PROVIDER=
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# Hash algorithm chosen in the Robokassa shop settings: md5, sha256, sha384 or sha512
ROBOKASSA_HASH=sha256
# 1 = Robokassa test mode with test passwords
ROBOKASSA_TEST=0
# Foreign mailboxes (Gmail, Outlook, iCloud) go through Brevo; Russian ones stay on Unisender Go
BREVO_API_KEY=
MAIL_FROM_INTL=
# 1 = if Unisender Go fails, send Russian mailboxes through Brevo too (cross-border transfer, needs a notice to Roskomnadzor)
MAIL_RU_FALLBACK_ABROAD=0

# Prodamus (страницы оплаты payform.ru): секретный ключ из личного кабинета Prodamus.
# Адрес уведомлений в настройках Prodamus (лучше в punycode): https://xn--80axddamoif3i.xn--p1ai/api/billing/webhook/prodamus
PRODAMUS_SECRET_KEY=
# 1 = принимать тестовую оплату на 1 ₽ (подписка на 1 день, один раз на аккаунт); включать только на время проверки и сразу выключать
PRODAMUS_TEST=0

# Telegram: бот и мини-приложение. Токен выдаёт @BotFather; пусто = выключено.
# Секрет вебхука: любая случайная строка из латиницы, цифр, _ и - (до 256 символов), например: openssl rand -hex 32
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional separate HTTPS endpoint for Telegram delivery, e.g. a relay.
TELEGRAM_WEBHOOK_URL=
